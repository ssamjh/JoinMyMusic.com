---
import { btnAccent, modalActions } from "../lib/ui";
---

{/* Popup messages pushed from the admin panel. */}
<div
  id="announceModal"
  class="modal-overlay"
  style="z-index:54"
  onclick="if (event.target === event.currentTarget) closeAnnouncement()"
>
  <div
    class="modal-card narrow text-center"
    role="dialog"
    aria-modal="true"
    aria-labelledby="announceModalTitle"
    onclick="event.stopPropagation()"
  >
    <div class="px-7 pt-8 pb-[22px]">
      <h2 id="announceModalTitle" class="m-0 text-xl font-bold tracking-[-0.02em]">
        Announcement
      </h2>
      <div
        id="announce-text"
        class="mt-3 text-sm leading-normal break-words whitespace-pre-wrap text-muted"
      >
      </div>
    </div>
    <div class={modalActions}>
      <button class={btnAccent} onclick="closeAnnouncement()">OK</button>
    </div>
  </div>
</div>
