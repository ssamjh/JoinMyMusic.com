---
import NextUp from "./NextUp.astro";
/**
 * The jukebox: the up-next record on the left, the turntable in the middle
 * (album art as a spinning vinyl with a tonearm that tracks playback progress)
 * and the recently-played records on the right, with the track metadata below.
 * On a song change app.js carries the played record into the history rack and
 * the up-next record onto the platter.
 *
 * Everything with a bare class name here (#art-card, .platter, .tonearm-*, …) is
 * driven by app.js and/or the CSS in global.css — see the "Jukebox" section
 * there. Layout and typography around it are Tailwind utilities.
 */
---

{/*
  pb-[7vh] matches the dock's -mt-[7vh] lift, so scrolled content never sits under the dock.
  The 1:2 before/after spacers place the player a third of the way down the free space;
  they collapse to nothing once the content overflows.
*/}
<main
  class="relative z-[2] flex min-h-0 flex-1 flex-col items-center justify-start overflow-y-auto px-6 pb-[7vh] before:min-h-0 before:flex-1 after:min-h-0 after:flex-[2] max-stack:pb-0 max-stack:before:hidden max-stack:after:hidden"
>
  <div
    class="player-layout mx-0 flex shrink-0 max-w-full flex-col items-center gap-[clamp(14px,2vh,30px)] max-stack:my-6 max-stack:gap-6"
  >
    <NextUp />
    <div class="player-stage jukebox-deck">
      <div class="now-playing">
        <div class="deck-role">Now playing</div>
        <a id="playing-link" data-art-ready="false" target="_blank" rel="noopener noreferrer" style="display:block;">
          <div class="platter" aria-hidden="true"></div>
          <div id="art-card">
            <div class="art-placeholder"></div>
            <img
              id="playing-image"
              crossorigin="anonymous"
              draggable="false"
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              alt=""
              width="400"
              height="400"
            />
            <div class="record-overlay"></div>
            <svg
              id="record-label"
              class="record-label"
              viewBox="0 0 100 100"
              aria-hidden="true"
            >
              <defs>
                <path id="label-arc-top" d="M 12.5 50 A 37.5 37.5 0 0 1 87.5 50" />
                <path id="label-arc-bottom" d="M 6 50 A 44 44 0 0 0 94 50" />
                <radialGradient id="label-shade" cx="50%" cy="40%" r="70%">
                  <stop offset="0%" stop-color="#fff" stop-opacity="0.16" />
                  <stop offset="55%" stop-color="#fff" stop-opacity="0.03" />
                  <stop offset="100%" stop-color="#000" stop-opacity="0.28" />
                </radialGradient>
              </defs>
              <circle class="label-paper" cx="50" cy="50" r="50" />
              <circle cx="50" cy="50" r="50" fill="url(#label-shade)" />
              <circle class="label-ring" cx="50" cy="50" r="47" />
              <circle class="label-ring" cx="50" cy="50" r="29" />
              <text id="label-title" class="label-text">
                <textPath href="#label-arc-top" startOffset="50%"></textPath>
              </text>
              <text id="label-artist" class="label-text">
                <textPath href="#label-arc-bottom" startOffset="50%"></textPath>
              </text>
              <text id="label-year" class="label-text label-year" x="50" y="41"></text>
              <text class="label-text label-rpm" x="50" y="62">33&#8531; RPM</text>
              <text class="label-text label-rpm" x="50" y="66.6">STEREO</text>
              <circle class="label-hole" cx="50" cy="50" r="3.6" />
            </svg>
            <div class="art-sheen"></div>
          </div>
          <div class="spindle" aria-hidden="true"></div>
          <div class="tonearm-mount" aria-hidden="true">
            <div class="tonearm" id="tonearm">
              <div class="tonearm-cw"></div><div class="tonearm-arm"></div>
              <div class="tonearm-pivot"></div><div class="tonearm-head"></div>
            </div>
          </div>
        </a>
      </div>
    </div>

    <div id="player-metadata" class="max-w-[min(92vw,680px)] text-center max-stack:order-1">
      {/* With effects on: a slot inside the speaker window that the title card hangs out of. */}
      <div class="title-slot">
        <div class="title-plate" id="title-plate">
          <div class="div-playing-title"></div>
          <div class="div-playing-artist"></div>
        </div>
      </div>
      <div class="playing-details" id="playing-details"></div>
      <div class="plain-progress">
        <div id="track-progress" role="progressbar" aria-label="Track progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="track-progress-fill"></span></div>
        <div class="track-times"><span id="track-elapsed">0:00</span><span id="track-duration">0:00</span></div>
      </div>
    </div>
    <aside
      class="history-panel max-stack:order-3 max-stack:h-auto"
      id="history-panel"
      data-expanded="false"
      style="display:none"
      aria-label="Recently played songs"
    >
      <button
        class="history-toggle"
        id="history-toggle"
        type="button"
        aria-controls="history-list"
        aria-expanded="false"
      >
        <span id="history-toggle-text">Show recently played</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="m3.5 6 4.5 4 4.5-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="history-head">Recent</div>
      <div class="history-list" id="history-list"></div>
    </aside>
    <div class="history-reserve" aria-hidden="true">
      <div class="history-head">Recent</div>
      <div class="history-reserve-row">
        <span class="history-reserve-slot"><span class="platter"></span></span>
        <span class="history-reserve-slot"><span class="platter"></span></span>
        <span class="history-reserve-slot"><span class="platter"></span></span>
        <span class="history-reserve-slot"><span class="platter"></span></span>
      </div>
    </div>
  </div>
</main>
