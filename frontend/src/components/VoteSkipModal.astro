---
import { btnGhost, btnDanger, modalActions, turnstileWrap } from "../lib/ui";
---

<div
  id="voteSkipModal"
  class="modal-overlay"
  style="z-index:52"
  onclick="closeModalsFromOverlay(event)"
>
  <div
    class="modal-card narrow text-center"
    role="dialog"
    aria-modal="true"
    aria-labelledby="voteModalTitle"
    onclick="event.stopPropagation()"
  >
    <div class="px-7 pt-8 pb-[22px]">
      <h2 id="voteModalTitle" class="m-0 text-xl font-bold tracking-[-0.02em]">
        Vote to skip?
      </h2>
      <div class="mt-2 text-sm leading-normal text-muted">
        Skip the current song if enough listeners agree.
      </div>
      <div class="mt-6 flex items-baseline justify-center gap-1.5">
        <span class="text-[34px] font-bold text-accent" id="vote-count">0</span>
        <span class="text-base text-muted">/ <span id="votes-needed">0</span> votes</span>
      </div>
      <div class="mt-3.5 h-[7px] overflow-hidden rounded-[4px] bg-elev">
        <div
          id="vote-bar-fill"
          class="h-full w-0 rounded-[4px] bg-accent transition-[width] duration-500 ease-dock"
        >
        </div>
      </div>
      <div class={turnstileWrap}>
        <div id="turnstile-vote"></div>
      </div>
    </div>
    <div class={modalActions}>
      <button class={btnGhost} onclick="closeModals()">Cancel</button>
      <button id="confirmVoteSkipBtn" class={btnDanger} disabled>Vote to skip</button>
    </div>
  </div>
</div>
