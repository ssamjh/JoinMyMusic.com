---
import Icon from "./Icon.astro";
---

<header
  class="relative z-[3] flex items-center justify-between px-7 py-4 pt-[max(1rem,env(safe-area-inset-top))]"
>
  <div>
    <div class="text-[15px] font-semibold tracking-[-0.01em]">Music Sync</div>
    <div class="mt-0.5 text-xs tracking-[0.02em] text-muted">JoinMyMusic.com</div>
  </div>
  {/* .header-actions is the hook body.display-mode uses to strip the controls. */}
  <div class="header-actions flex items-center gap-2.5">
    {/* The only listener count on the page; app.js updates every .listener-count. */}
    <div
      class="header-listeners flex h-10 items-center gap-2 rounded-full border border-line bg-elev px-3.5 text-[13px] text-muted"
    >
      <span class="live-dot"></span>
      <span><span class="listener-count inline-block min-w-[2ch] text-center tabular-nums">0</span> listening</span>
    </div>
    <button
      id="bgToggleBtn"
      class="icon-btn"
      title="Toggle background effects"
      aria-label="Toggle background effects"
      onclick="toggleBgAnimation()"
    >
      <Icon name="waveform" size={18} strokeWidth={1.7} />
    </button>
    <button
      id="themeToggleBtn"
      class="icon-btn"
      title="Toggle light/dark"
      aria-label="Toggle light/dark theme"
      onclick="toggleTheme()"
    >
      <span class="theme-icon-dark">
        <Icon name="sun" size={18} strokeWidth={1.7} />
      </span>
      <span class="theme-icon-light" style="display:none">
        <Icon name="moon" size={18} strokeWidth={1.7} />
      </span>
    </button>
  </div>
</header>
